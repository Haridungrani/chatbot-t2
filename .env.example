# ==============================================
# CHATBOT PROJECT - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and update with your values
# Never commit .env file to version control!

# ==============================================
# DATABASE CONFIGURATION (LOCAL POSTGRESQL)
# ==============================================
# Update these with your local PostgreSQL credentials
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/chatbot_db2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=chatbot_db2

# ==============================================
# HASURA CONFIGURATION
# ==============================================
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_WS_ENDPOINT=ws://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=chatbot_admin_secret_2026

# JWT Configuration (must match Hasura JWT secret)
# IMPORTANT: Change this key in production! Must be at least 32 characters
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==============================================
# FASTAPI BACKEND CONFIGURATION
# ==============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================
# NEXT.JS FRONTEND CONFIGURATION
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
NEXT_PUBLIC_HASURA_WS_ENDPOINT=ws://localhost:8080/v1/graphql

# Note: NEXT_PUBLIC_ prefix makes the variable available in browser
# Never expose sensitive secrets with NEXT_PUBLIC_ prefix!

# ==============================================
# CHATBOT AI CONFIGURATION (Optional)
# ==============================================
# Add your AI service API keys here
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ==============================================
# DEVELOPMENT/PRODUCTION MODE
# ==============================================
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
